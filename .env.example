# --- Required ---
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lte_dev
# Long random string used to sign auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public URL of the app, no trailing slash. Used in email links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (optional in development) ---
# Without SMTP_HOST, emails are printed to the server console instead of being sent.
# Works with any SMTP provider, e.g. Resend (smtp.resend.com) or Brevo (smtp-relay.brevo.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Let's Talk English"

# --- Monitoring (optional) ---
# Sentry DSN. Leave empty to disable error reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
