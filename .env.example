# Copy this file to .env and adjust if needed. The defaults match docker-compose.yml.

# --- Required ---
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lte_dev
# Long random string used to sign login tokens. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Address of the app, no trailing slash. Used in email links and to check where requests come from.
# Read when the app starts, so the same build can run at any address.
SERVER_URL=http://localhost:3000
# Time zone for dates shown in the app (practice dates, history).
TZ=Asia/Kolkata

# --- Email (optional) ---
# Without SMTP_HOST, emails (account confirmation, password reset, educator approval)
# are printed in the terminal running the app instead of being sent. Copy the link from there.
# Any SMTP provider works, e.g. Resend (smtp.resend.com) or Brevo (smtp-relay.brevo.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Let's Talk English"

# --- Test-only switches (never set these for real use) ---
# RATE_LIMIT_DISABLED=true   # turns off login/sign-up/content rate limits (end-to-end tests)
# PAYLOAD_DB_PUSH=false      # use committed migrations instead of pushing schema changes
